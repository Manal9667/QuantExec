# Copy this file to .env for the local Docker demo. For hosted use, replace
# both origins with the public frontend and API origins and terminate TLS at
# the hosting proxy.

QUANTEXEC_API_HOST=127.0.0.1
QUANTEXEC_API_PORT=8000
QUANTEXEC_LOG_LEVEL=INFO
QUANTEXEC_DB_PATH=experiments/experiments.db
QUANTEXEC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
QUANTEXEC_COMMISSION_BPS=0.0
QUANTEXEC_EXCHANGE_FEE_BPS=0.0
QUANTEXEC_FIXED_FEE_PER_FILL=0.0
