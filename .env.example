# QuantExec backend configuration (spec section 41).
#
# Copy this file to `.env` at the repository root and edit as needed. Every
# variable is optional; the value shown is the built-in default, so an empty
# or absent .env reproduces the previous hardcoded behaviour. Real shell
# environment variables always override values set here.
#
#   cp .env.example .env
#
# See backend/config.py for how these are parsed.

# --- Persistence -----------------------------------------------------------
# Absolute or repo-relative path to the SQLite experiment database.
QUANTEXEC_DB_PATH=experiments/experiments.db

# --- API server ------------------------------------------------------------
# Host/port used by `python backend/main.py`. (When running under uvicorn
# directly, pass --host/--port to uvicorn instead.)
QUANTEXEC_API_HOST=127.0.0.1
QUANTEXEC_API_PORT=8000

# Comma-separated CORS allow-list. "*" is convenient for local dev; set an
# explicit list (e.g. http://localhost:5173) before exposing the API.
QUANTEXEC_CORS_ORIGINS=*

# --- Logging ---------------------------------------------------------------
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
QUANTEXEC_LOG_LEVEL=INFO

# --- Default transaction-cost assumptions ----------------------------------
# Applied when a POST /experiments request omits `costs`. Basis points, and a
# flat fee per fill. Defaults are 0 so results are cost-free unless configured.
QUANTEXEC_COMMISSION_BPS=0.0
QUANTEXEC_EXCHANGE_FEE_BPS=0.0
QUANTEXEC_FIXED_FEE_PER_FILL=0.0
